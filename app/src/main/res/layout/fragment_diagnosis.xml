<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingEnd="20dp"
            android:text="←  뒤로"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="피해 상황 확인"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="현재 의심되는 피해 유형을 선택해 주세요."
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="어떤 피해가 의심되나요?"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSmishing"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical|start"
            android:text="문자·메신저 피싱"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            app:backgroundTint="@color/card_charcoal"
            app:cornerRadius="14dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoicePhishing"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start"
            android:text="보이스피싱·금전 피해"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            app:backgroundTint="@color/card_charcoal"
            app:cornerRadius="14dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeepfake"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start"
            android:text="딥페이크·불법 촬영물"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            app:backgroundTint="@color/card_charcoal"
            app:cornerRadius="14dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccount"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start"
            android:text="계정 해킹·도용"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            app:backgroundTint="@color/card_charcoal"
            app:cornerRadius="14dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOnlineFraud"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start"
            android:text="온라인 거래 사기"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            app:backgroundTint="@color/card_charcoal"
            app:cornerRadius="14dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/surface_light_dark"
            android:padding="16dp"
            android:text="긴급한 금전 또는 신체 피해가 진행 중이라면 진단보다 먼저 112 또는 금융기관에 연락하세요."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>