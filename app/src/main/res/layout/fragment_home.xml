<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 상단 헤더 -->
        <!-- ==== 수정 시작: 디자인 캡처 반영 - 🛡 이모지 대신 실제 방패 로고 아이콘 사용 ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_shield_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SWU퍼디펜스"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ==== 수정: 알림(종) 아이콘 삭제 (요청에 따라 제거) ==== -->

        </LinearLayout>
        <!-- ==== 수정 끝 ==== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="환영합니다, 👋"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Good Evening"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="오늘도 안전한 하루 되세요."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- 보안 점수 카드 -->
        <!-- ==== 수정 시작: id/clickable 추가 - 탭하면 마지막 피해 상황 확인 결과로 이동 (기존: 클릭 불가) ==== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSecurityScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/card_charcoal"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">
        <!-- ==== 수정 끝 ==== -->

            <!-- ==== 수정 시작: 디자인 캡처(0723_141548365_02) 반영 - 세로 스택 → 좌:텍스트/우:원형 게이지 구조로 변경 ==== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SECURITY SCORE"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- TODO: 백엔드 연동 지점 - 실제 점수는 진단/증거/체크리스트 이력 기반으로 계산되어 DB에서 조회될 예정. 지금은 샘플 값 -->
                    <TextView
                        android:id="@+id/tvSecurityScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="92/100"
                        android:textColor="@color/text_primary"
                        android:textSize="44sp"
                        android:textStyle="bold" />

                    <!-- ==== 수정: "지난 주 대비 +N점 상승" 문구 제거 ==== -->
                    <TextView
                        android:id="@+id/tvSecurityLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="매우 안전"
                        android:textColor="@color/orange_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp">

                    <!-- ==== 수정: 커스텀 ring 드로어블(bg_score_ring)이 progress 비율과 실제로
                    그려지는 호(arc) 길이가 어긋나는 문제가 있어, Material의 검증된
                    CircularProgressIndicator로 교체 (기존: ProgressBar + progressDrawable) ====
                    TODO: 백엔드 연동 지점 - progress 값을 tvSecurityScore와 동일한 실제 점수로 교체 -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/scoreRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:progress="92"
                        app:indicatorColor="@color/orange_primary"
                        app:indicatorSize="84dp"
                        app:trackColor="@color/card_border"
                        app:trackCornerRadius="5dp"
                        app:trackThickness="9dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🛡"
                        android:textColor="@color/orange_primary"
                        android:textSize="26sp" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="›"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp" />

            </LinearLayout>
            <!-- ==== 수정 끝 ==== -->

        </com.google.android.material.card.MaterialCardView>

        <!-- 피해 상황 확인 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/card_charcoal"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="88dp"
                android:padding="14dp">

                <TextView
                    android:id="@+id/ivDiagnosisIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_icon_circle"
                    android:gravity="center"
                    android:text="🔍"
                    android:textColor="@color/orange_primary"
                    android:textSize="22sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDiagnosisTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="6dp"
                    android:maxLines="1"
                    android:text="피해가 의심되나요?"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/btnStartDiagnosis"
                    app:layout_constraintStart_toEndOf="@id/ivDiagnosisIcon"
                    app:layout_constraintTop_toTopOf="@id/ivDiagnosisIcon" />

                <!-- ==== 수정: "요."만 다음 줄로 밀려 어색하게 끊기던 문제를 글자 크기를 줄여
                해결 (기존: 13sp) ==== -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:breakStrategy="simple"
                    android:maxLines="2"
                    android:text="피해 상황을 바로 확인하세요."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="@id/tvDiagnosisTitle"
                    app:layout_constraintStart_toStartOf="@id/tvDiagnosisTitle"
                    app:layout_constraintTop_toBottomOf="@id/tvDiagnosisTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartDiagnosis"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="확인하기  →"
                    android:textColor="@color/background_black"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/orange_primary"
                    app:cornerRadius="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 미니카드 2x2 그리드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChecklist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card_charcoal"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 아이콘 + 제목 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="🛡"
                            android:textColor="@color/orange_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="후속 조치"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- 제공 서비스 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="제공 서비스"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- 서비스 개수 -->
                    <TextView
                        android:id="@+id/tvChecklistProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="7개"
                        android:textColor="@color/orange_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEvidence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card_charcoal"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ==== 수정 시작: 아이콘을 원형 배지 안에 배치 (기존: 이모지+텍스트 한 줄) ==== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="📁"
                            android:textColor="@color/orange_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="증거 정리"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                    <!-- ==== 수정 끝 ==== -->

                    <!-- ==== 수정 시작: 디자인 캡처 반영 - "저장된 증거" 서브라벨 추가 ==== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="저장된 증거"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <!-- ==== 수정 끝 ==== -->

                    <!-- TODO: 백엔드 연동 지점 - EvidenceDao로 실제 저장 건수 조회 예정 -->
                    <TextView
                        android:id="@+id/tvEvidenceCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="28 건"
                        android:textColor="@color/orange_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSmishingCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card_charcoal"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ==== 수정 시작: 아이콘을 원형 배지 안에 배치 (기존: 이모지+텍스트 한 줄) ==== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="🔍"
                            android:textColor="@color/orange_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="스미싱 점검"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                    <!-- ==== 수정 끝 ==== -->

                    <!-- ==== 수정 시작: 디자인 캡처 반영 - "최근 점검" 상태 표시로 변경 (기존: CTA 문구) ==== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="최근 점검"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- TODO: 백엔드 연동 지점 - SmishingCheckDao의 최근 검사 결과로 상태/색상 교체 -->
                    <TextView
                        android:id="@+id/tvSmishingStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="안전"
                        android:textColor="@color/safe_green"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <!-- ==== 수정 끝 ==== -->

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReportAgency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card_charcoal"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ==== 수정 시작: 아이콘을 원형 배지 안에 배치 (기존: 이모지+텍스트 한 줄) ==== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="🏛"
                            android:textColor="@color/orange_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="신고·상담 기관"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                    <!-- ==== 수정 끝 ==== -->

                    <!-- ==== 수정 시작: 디자인 캡처 반영 - "연락 가능한 기관" 서브라벨 추가 ==== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="연락 가능한 기관"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <!-- ==== 수정 끝 ==== -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="5 개"
                        android:textColor="@color/orange_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- 최근 활동 -->
        <!-- ==== 수정 시작: 디자인 캡처 반영 - "전체 보기 ›" 링크 추가 (기존: 제목 단독) ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="최근 활동"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewAllActivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="전체 보기 ›"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>
        <!-- ==== 수정 끝 ==== -->

        <!-- ==== 수정: ActivityLog 실데이터로 채움 (기존: 하드코딩 샘플 데이터) ==== -->
        <TextView
            android:id="@+id/tvActivityEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:paddingVertical="20dp"
            android:text="아직 활동 내역이 없습니다."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/recentActivityContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="90dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
