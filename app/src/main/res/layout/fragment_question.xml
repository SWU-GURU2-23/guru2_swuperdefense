<?xml version="1.0" encoding="utf-8"?>
<!-- ==== 수정: MD 문서의 실제 질문이 예전 더미 질문보다 훨씬 길어져, 작은 화면에서 버튼이
화면 밖으로 밀려나지 않도록 ScrollView로 감쌈 (기존: ConstraintLayout이 화면을 그대로 채움) ==== -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingEnd="20dp"
            android:text="←  뒤로"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvIncidentType"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_category_chip"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/orange_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <ProgressBar
            android:id="@+id/questionProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginTop="24dp"
            android:max="3"
            android:progress="1"
            android:progressBackgroundTint="@color/card_border"
            android:progressTint="@color/orange_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvIncidentType" />

        <TextView
            android:id="@+id/tvQuestionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="질문 1 / 3"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/questionProgress" />

        <!-- ==== 수정: 실제 질문 문구가 길어 27sp로는 여러 줄로 빽빽하게 끊겨 가독성이 떨어져
        글자 크기를 줄이고 줄간격을 넓힘 (기존: 27sp, 줄간격 없음) ==== -->
        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:breakStrategy="simple"
            android:lineSpacingExtra="6dp"
            android:text="질문 내용"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuestionCount" />

        <TextView
            android:id="@+id/tvQuestionDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:breakStrategy="simple"
            android:lineSpacingExtra="4dp"
            android:text="현재 상황과 가장 가까운 답변을 선택해 주세요."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuestion" />
        <!-- ==== 수정 끝 ==== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnYes"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="32dp"
            android:text="네, 해당돼요"
            android:textColor="@color/background_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/orange_primary"
            app:cornerRadius="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuestionDescription" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNo"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="아니요"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:backgroundTint="@color/card_charcoal"
            app:cornerRadius="14dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnYes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnsure"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="잘 모르겠어요"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnNo" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
