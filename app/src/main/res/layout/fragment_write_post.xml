<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="←  뒤로"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvWriteHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="글쓰기"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="카테고리"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipCatPhishing"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:text="피싱/스미싱"
                    android:textColor="@color/orange_primary"
                    app:backgroundTint="#24170D"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/orange_primary"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipCatAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:text="계정 도용"
                    android:textColor="@color/text_secondary"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipCatMoney"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:text="금전 사기"
                    android:textColor="@color/text_secondary"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipCatVoice"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:text="보이스피싱"
                    android:textColor="@color/text_secondary"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipCatEtc"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="기타"
                    android:textColor="@color/text_secondary"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </HorizontalScrollView>

        <EditText
            android:id="@+id/etPostTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input_field"
            android:hint="제목을 입력하세요."
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etPostBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top"
            android:hint="내용을 입력하세요."
            android:inputType="textMultiLine"
            android:minLines="8"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <CheckBox
            android:id="@+id/cbAnonymousPost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:buttonTint="@color/orange_primary"
            android:text="익명으로 게시"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvWriteError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/danger_red"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitPost"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="등록하기"
            android:textColor="@color/background_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/orange_primary"
            app:cornerRadius="14dp" />

    </LinearLayout>

</ScrollView>
